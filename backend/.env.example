# Flask
FLASK_ENV=development
PORT=5001
FLASK_SECRET_KEY=replace-with-a-random-local-development-secret
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800

# Database and local persistence
DATABASE_URL=sqlite:///hiremind.db
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216
MAX_UPLOAD_FILE_SIZE=10485760
MAX_UPLOAD_FILES=20
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider configuration (server-side only; never use VITE_* for secrets)
# Set AI_PROVIDER to "groq" or "huggingface". If neither key is set, offline heuristics activate automatically.
AI_PROVIDER=huggingface
HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN_HERE
HF_MODEL=openai/gpt-oss-120b
HF_PROVIDER=fireworks-ai
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_TOKEN_HERE
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_TIMEOUT_SECONDS=15
USE_ONLINE_EMBEDDINGS=true
